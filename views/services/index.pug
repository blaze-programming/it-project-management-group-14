extends ../layout

block content
  .d-flex.justify-content-between.align-items-center.mb-4
    h1 Services
    if sessionUser.role === 'owner'
      a.btn.btn-primary(href='/services/new') + New Service
  .table-responsive
    table.table.table-striped.table-hover
      thead.table-dark
        tr
          th ID
          th Service Name
          th Hourly Cost
          th Scheduled Date
          th Time
          th Technician ID
          th Repair ID
          th Actions
      tbody
        each s in services
          tr
            td= s.serviceid
            td= s.servicename
            td $#{Number(s.hourlycost).toFixed(2)}
            td= s.scheduleddate ? new Date(s.scheduleddate).toLocaleDateString() : 'N/A'
            td= s.scheduledtime
            td= s.technicianid
            td= s.repairid
            td
              a.btn.btn-sm.btn-info.me-1(href=`/services/${s.serviceid}`) View
              if sessionUser.role === 'owner'
                a.btn.btn-sm.btn-warning.me-1(href=`/services/${s.serviceid}/edit`) Edit
                form(action=`/services/${s.serviceid}/delete`, method='POST', style='display:inline')
                  input(type='hidden', name='_csrf', value=csrfToken)
                  button.btn.btn-sm.btn-danger(type='submit', onclick='return confirm("Delete service?")') Delete
