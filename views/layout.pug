doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= title + ' | Auto Repair Shop'
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet', href='/stylesheets/style.css')
  body
    if sessionUser
      nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
        .container-fluid
          a.navbar-brand(href='/') 🔧 Auto Repair Shop
          button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navMenu')
            span.navbar-toggler-icon
          #navMenu.collapse.navbar-collapse
            ul.navbar-nav.me-auto
              li.nav-item
                a.nav-link(href='/') Dashboard
              if sessionUser.role !== 'customer'
                li.nav-item
                  a.nav-link(href='/repairs') Repairs
                li.nav-item
                  a.nav-link(href='/services') Services
                li.nav-item
                  a.nav-link(href='/parts') Parts
              if sessionUser.role === 'owner'
                li.nav-item
                  a.nav-link(href='/customers') Customers
                li.nav-item
                  a.nav-link(href='/vehicles') Vehicles
                li.nav-item
                  a.nav-link(href='/employees') Employees
                li.nav-item
                  a.nav-link(href='/transactions') Transactions
              if sessionUser.role === 'customer'
                li.nav-item
                  a.nav-link(href=`/customers/${sessionUser.id}`) My Profile
            ul.navbar-nav
              li.nav-item
                span.navbar-text.me-3 #{sessionUser.firstname} (#{sessionUser.role})
              li.nav-item
                form(action='/auth/logout', method='POST')
                  input(type='hidden', name='_csrf', value=csrfToken)
                  button.btn.btn-outline-light.btn-sm(type='submit') Logout
    .container.mt-4
      block content
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    script(src='/javascripts/app.js')
