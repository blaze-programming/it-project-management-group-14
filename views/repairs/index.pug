extends ../layout

block content
  .d-flex.justify-content-between.align-items-center.mb-4
    h1 Repairs
    a.btn.btn-primary(href='/repairs/new') + Schedule Repair
  .table-responsive
    table.table.table-striped.table-hover
      thead.table-dark
        tr
          th ID
          th Vehicle ID
          th Technician ID
          th Date
          th Time
          th Status
          th Actions
      tbody
        each r in repairs
          tr
            td= r.repairid
            td= r.vehicleid
            td= r.technicianid
            td= r.scheduleddate ? new Date(r.scheduleddate).toLocaleDateString() : 'N/A'
            td= r.scheduledtime
            td
              if r.iscompleted
                span.badge.bg-success Completed
              else if r.isplanned
                span.badge.bg-warning.text-dark Planned
              else
                span.badge.bg-secondary Unplanned
            td
              a.btn.btn-sm.btn-info.me-1(href=`/repairs/${r.repairid}`) View
              a.btn.btn-sm.btn-warning.me-1(href=`/repairs/${r.repairid}/edit`) Edit
              if !r.iscompleted
                form(action=`/repairs/${r.repairid}/complete`, method='POST', style='display:inline')
                  input(type='hidden', name='_csrf', value=csrfToken)
                  button.btn.btn-sm.btn-success.me-1(type='submit') ✓ Complete
              if sessionUser.role === 'owner'
                form(action=`/repairs/${r.repairid}/delete`, method='POST', style='display:inline')
                  input(type='hidden', name='_csrf', value=csrfToken)
                  button.btn.btn-sm.btn-danger(type='submit', onclick='return confirm("Delete repair?")') Delete
