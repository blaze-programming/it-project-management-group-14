extends ../layout

block content
  .d-flex.justify-content-between.align-items-center.mb-4
    h1 Employees
    a.btn.btn-primary(href='/employees/new') + New Employee
  .table-responsive
    table.table.table-striped.table-hover
      thead.table-dark
        tr
          th ID
          th Name
          th Email
          th Position
          th Role
          th Hourly Wage
          th Hiring Date
          th Actions
      tbody
        each e in employees
          tr
            td= e.employeeid
            td #{e.firstname} #{e.lastname}
            td= e.email
            td= e.position
            td
              span(class=`badge bg-${e.role === 'owner' ? 'danger' : 'secondary'}`)= e.role
            td $#{Number(e.hourlywage).toFixed(2)}
            td= e.hiringdate ? new Date(e.hiringdate).toLocaleDateString() : 'N/A'
            td
              a.btn.btn-sm.btn-info.me-1(href=`/employees/${e.employeeid}`) View
              a.btn.btn-sm.btn-warning.me-1(href=`/employees/${e.employeeid}/edit`) Edit
              form(action=`/employees/${e.employeeid}/delete`, method='POST', style='display:inline')
                input(type='hidden', name='_csrf', value=csrfToken)
                button.btn.btn-sm.btn-danger(type='submit', onclick='return confirm("Delete employee?")') Delete
