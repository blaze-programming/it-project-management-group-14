extends ../layout

block content
  .row.justify-content-center
    .col-md-6
      .card.shadow-sm
        .card-body.p-4
          h2.card-title.mb-4 Customer Registration
          if error
            .alert.alert-danger= error
          form(action='/auth/register', method='POST')
            .row.g-3
              .col-sm-6
                label.form-label First Name
                input.form-control(type='text', name='firstname', required)
              .col-sm-6
                label.form-label Last Name
                input.form-control(type='text', name='lastname', required)
              .col-12
                label.form-label Street Address
                input.form-control(type='text', name='streetaddress')
              .col-sm-6
                label.form-label City
                input.form-control(type='text', name='city')
              .col-sm-6
                label.form-label Zip Code
                input.form-control(type='text', name='zipcode')
              .col-md-6
                label.form-label Email
                input.form-control(type='email', name='email', required)
              .col-md-6
                label.form-label Phone Number
                input.form-control(type='tel', name='phonenumber')
              .col-12
                label.form-label Password
                input.form-control(type='password', name='password', required, minlength='8')
            button.btn.btn-success.w-100.mt-3(type='submit') Create Account
          hr
          p.text-center.mb-0
            | Already have an account? 
            a(href='/auth/login') Sign in
