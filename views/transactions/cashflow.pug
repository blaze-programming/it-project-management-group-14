extends ../layout

block content
  h1.mb-4 Cash Flow Report
  form.row.g-3.mb-4(method='GET', action='/transactions/cashflow')
    .col-sm-4
      label.form-label Start Date
      input.form-control(type='date', name='start', value=startDate)
    .col-sm-4
      label.form-label End Date
      input.form-control(type='date', name='end', value=endDate)
    .col-sm-4.d-flex.align-items-end
      button.btn.btn-primary(type='submit') Filter
  .row.g-4.mb-4
    .col-md-4
      .card.text-bg-success
        .card-body
          p.mb-1 Total Revenue
          h3 $#{Number(summary.total).toFixed(2)}
    .col-md-4
      .card.text-bg-info
        .card-body
          p.mb-1 Total Transactions
          h3= summary.count
  h4 By Payment Method
  .table-responsive
    table.table.table-bordered
      thead.table-dark
        tr
          th Payment Method
          th Count
          th Total
      tbody
        each val, method in summary.byMethod
          tr
            td= method
            td= val.count
            td $#{Number(val.total).toFixed(2)}
  h4.mt-4 All Transactions in Range
  .table-responsive
    table.table.table-striped.table-sm
      thead.table-dark
        tr
          th Invoice #
          th Customer ID
          th Amount
          th Method
          th Date
      tbody
        each t in summary.rows
          tr
            td= t.invoicenumber
            td= t.customerid
            td $#{Number(t.transactionamount).toFixed(2)}
            td= t.paymentmethod
            td= new Date(t.created_at).toLocaleDateString()
