extends ../layout

block content
  .d-flex.justify-content-between.align-items-center.mb-4
    h1= part.partname
    .btn-group
      if sessionUser.role === 'owner'
        a.btn.btn-warning(href=`/parts/${part.partid}/edit`) Edit
      a.btn.btn-outline-secondary(href='/parts') Back
  .card
    .card-body
      p #[strong Vendor:] #{part.vendorname}
      p #[strong Cost:] $#{Number(part.cost).toFixed(2)}
      p
        strong Quantity In Stock: 
        if part.quantityinstock <= 5
          span.badge.bg-danger #{part.quantityinstock} — Low Stock!
        else
          = part.quantityinstock
      p #[strong Added:] #{new Date(part.created_at).toLocaleDateString()}
