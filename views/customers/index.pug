extends ../layout

block content
  .d-flex.justify-content-between.align-items-center.mb-4
    h1 Customers
    a.btn.btn-primary(href='/customers/new') + New Customer
  .table-responsive
    table.table.table-striped.table-hover
      thead.table-dark
        tr
          th ID
          th First Name
          th Last Name
          th Email
          th Phone
          th City
          th Actions
      tbody
        each c in customers
          tr
            td= c.customerid
            td= c.firstname
            td= c.lastname
            td= c.email
            td= c.phonenumber
            td= c.city
            td
              a.btn.btn-sm.btn-info.me-1(href=`/customers/${c.customerid}`) View
              a.btn.btn-sm.btn-warning.me-1(href=`/customers/${c.customerid}/edit`) Edit
              form(action=`/customers/${c.customerid}/delete`, method='POST', style='display:inline')
                button.btn.btn-sm.btn-danger(type='submit', onclick='return confirm("Delete this customer?")') Delete
