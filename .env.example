NODE_ENV=development
PORT=3000
USE_MOCK_DB=true

# PostgreSQL (used when USE_MOCK_DB=false)
DATABASE_URL=postgres://user:password@localhost:5432/autorepair

# Session
SESSION_SECRET=change_me_to_a_long_random_string

# JWT
JWT_SECRET=change_me_to_another_long_random_string
JWT_EXPIRES_IN=7d

# CSRF
CSRF_SECRET=change_me_to_yet_another_long_random_string
